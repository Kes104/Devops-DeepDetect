pipeline {
    agent any
    environment {
        DOCKER_TLS_VERIFY = "1"
        DOCKER_HOST = "tcp://192.168.58.2:2376"
        DOCKER_CERT_PATH = "/var/lib/jenkins/.minikube/certs"
        MINIKUBE_ACTIVE_DOCKERD = "minikube"
        KUBECONFIG = "/var/lib/jenkins/.kube/config"
    }
    stages {
        stage('Build and Deploy') {
            steps {
                dir('Model_Api') {
                    sh '''
                        eval $(minikube docker-env)

                        IMAGE_TAG=1.0.$BUILD_NUMBER
                        echo "Building Docker Image with tag $IMAGE_TAG"
                        docker build -t ddd:$IMAGE_TAG .

                        docker images | grep ddd

                        # Apply service.yaml if needed
                        kubectl apply -f service.yaml

                        # Update Deployment to use new image
                        kubectl set image deployment/my-app-deployment my-app-container=ddd:$IMAGE_TAG || kubectl apply -f deployment.yaml

                        # Wait for Deployment rollout to complete
                        kubectl rollout status deployment/my-app-deployment
                    '''
                }
            }
        }
    }
}
